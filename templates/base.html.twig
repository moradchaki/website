<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{% block title %}LUMINA ELITE | Precision Engineered Luxury{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;family=Inter:wght@100..900&amp;display=swap"
        rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .shadow-premium {
            box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.08);
        }

        .glass {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .hero-gradient {
            background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.08), transparent),
                radial-gradient(circle at bottom left, rgba(96, 1, 209, 0.08), transparent);
        }

        .animate-float {
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        .shimmer {
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            background-size: 200% 100%;
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% {
                background-position: -200% 0;
            }

            100% {
                background-position: 200% 0;
            }
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#0053db",
                        "on-primary": "#ffffff",
                        "primary-container": "#dbe1ff",
                        "on-primary-container": "#00174b",
                        "secondary": "#6001d1",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#eaddff",
                        "on-secondary-container": "#25005a",
                        "tertiary": "#8d4f00",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#ffdbcd",
                        "on-tertiary-container": "#360f00",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error-container": "#410002",
                        "background": "#f7f9fb",
                        "on-background": "#191c1e",
                        "surface": "#f7f9fb",
                        "on-surface": "#191c1e",
                        "surface-variant": "#dfe2eb",
                        "on-surface-variant": "#43474e",
                        "outline": "#73777f",
                        "outline-variant": "#c3c6cf",
                        "inverse-surface": "#2e3133",
                        "inverse-on-surface": "#eff1f3",
                        "inverse-primary": "#b4c5ff",
                        "surface-dim": "#d8dadc",
                        "surface-bright": "#f7f9fb",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceeef",
                        "surface-container-high": "#e6e8e9",
                        "surface-container-highest": "#e0e2e4"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.5rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-max": "1280px",
                        "gutter": "24px",
                        "margin-mobile": "20px",
                        "margin-desktop": "64px",
                        "unit": "8px"
                    },
                    "fontFamily": {
                        "headline-xl": ["Geist"],
                        "display-lg": ["Geist"],
                        "headline-lg": ["Geist"],
                        "button-text": ["Geist"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "display-lg-mobile": ["Geist"],
                        "label-md": ["Geist"]
                    },
                    "fontSize": {
                        "headline-xl": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "display-lg": ["64px", { "lineHeight": "1.1", "letterSpacing": "-0.04em", "fontWeight": "700" }],
                        "headline-lg": ["32px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "button-text": ["16px", { "lineHeight": "1", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "display-lg-mobile": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-md": ["14px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <!-- Top Navigation Bar -->
    <nav
        class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30 shadow-premium">
        <div class="flex justify-between items-center w-full px-margin-desktop max-w-container-max mx-auto h-20">
            <div class="flex items-center gap-12">
                <a class="font-headline-lg text-headline-lg font-bold tracking-tighter text-primary" href="{{ path('homepage') }}">LUMINA
                    ELITE</a>
                <div class="hidden md:flex gap-8 items-center">
                    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-300 font-label-md text-label-md"
                        href="{{ path('product_index') }}">Products</a>
                    <a class="text-primary font-bold border-b-2 border-primary pb-1 font-label-md text-label-md transition-all duration-300"
                        href="{{ path('homepage') }}">Gaming</a>
                    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-300 font-label-md text-label-md"
                        href="{{ path('business') }}">Business</a>
                    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-300 font-label-md text-label-md"
                        href="{{ path('student') }}">Student</a>
                    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-300 font-label-md text-label-md"
                        href="{{ path('workstations') }}">Workstations</a>
                    <a class="text-on-surface-variant font-medium hover:text-primary transition-colors duration-300 font-label-md text-label-md"
                        href="{{ path('accessories') }}">Accessories</a>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <a href="{{ path('comparison_index') }}" class="material-symbols-outlined text-primary cursor-pointer hover:scale-110 transition-transform"
                    data-icon="compare_arrows">compare_arrows</a>
                <a href="{{ path('cart_index') }}" class="material-symbols-outlined text-primary cursor-pointer hover:scale-110 transition-transform"
                    data-icon="shopping_cart">shopping_cart</a>
                {% if app.user %}
                    <a href="{{ path('product_wishlist') }}" class="material-symbols-outlined text-primary cursor-pointer hover:scale-110 transition-transform"
                        data-icon="favorite">favorite</a>
                {% endif %}
                {% if app.user %}
                    <div class="relative group">
                        <button class="material-symbols-outlined text-primary cursor-pointer hover:scale-110 transition-transform"
                            data-icon="account_circle">account_circle</button>
                        <div class="absolute right-0 top-full mt-2 w-48 bg-surface-container-lowest rounded-2xl border border-outline-variant/30 shadow-premium opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 overflow-hidden">
                            <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-3 px-4 py-3 hover:bg-surface-container-low transition-colors text-on-surface font-body-md">
                                <span class="material-symbols-outlined text-[18px]" data-icon="dashboard">dashboard</span>
                                Dashboard
                            </a>
                            <a href="{{ path('auth_profile') }}" class="flex items-center gap-3 px-4 py-3 hover:bg-surface-container-low transition-colors text-on-surface font-body-md">
                                <span class="material-symbols-outlined text-[18px]" data-icon="account_circle">account_circle</span>
                                Profile
                            </a>
                            <hr class="border-outline-variant/20 mx-3">
                            <a href="{{ path('auth_logout') }}" class="flex items-center gap-3 px-4 py-3 hover:bg-surface-container-low transition-colors text-error font-body-md">
                                <span class="material-symbols-outlined text-[18px]" data-icon="logout">logout</span>
                                Logout
                            </a>
                        </div>
                    </div>
                {% else %}
                    <a href="{{ path('auth_login') }}"
                        class="bg-primary text-on-primary px-5 py-2.5 rounded-xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg text-sm">Sign In</a>
                {% endif %}
            </div>
        </div>
    </nav>
    <main class="pt-20">
        {% block body %}{% endblock %}
    </main>
    <!-- Bottom Navigation Bar (Mobile only) -->
    <nav
        class="md:hidden fixed bottom-0 left-0 right-0 w-full z-40 rounded-t-xl bg-surface/90 backdrop-blur-2xl border-t border-outline-variant/30 shadow-premium h-20">
        <div class="flex justify-center items-center h-full gap-8 px-4">
            <div
                class="text-on-surface-variant flex items-center gap-2 px-4 hover:bg-black/5 transition-all rounded-lg py-2">
                <span class="material-symbols-outlined" data-icon="devices">devices</span>
                <span class="font-label-md text-label-md hidden sm:block">Models</span>
            </div>
            <div
                class="text-on-surface-variant flex items-center gap-2 px-4 hover:bg-black/5 transition-all rounded-lg py-2">
                <span class="material-symbols-outlined" data-icon="grid_view">grid_view</span>
                <span class="font-label-md text-label-md hidden sm:block">Specs</span>
            </div>
            <div
                class="bg-primary text-on-primary rounded-full px-6 py-2 flex items-center gap-2 shadow-lg active:scale-95 transition-all">
                <span class="material-symbols-outlined" data-icon="rocket_launch">rocket_launch</span>
                <span class="font-label-md text-label-md">Compare</span>
            </div>
        </div>
    </nav>
    <!-- Footer -->
    <footer class="w-full relative mt-20 bg-surface-container-lowest border-t border-outline-variant/30">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-desktop py-16 max-w-container-max mx-auto">
            <div class="col-span-1 md:col-span-1 space-y-6">
                <a class="font-headline-lg text-headline-lg text-primary font-bold tracking-tighter" href="{{ path('homepage') }}">LUMINA
                    ELITE</a>
                <p class="text-on-surface-variant font-body-md text-body-md">Redefining high-performance luxury
                    computing through precision engineering and avant-garde design.</p>
            </div>
            <div class="space-y-6">
                <h5 class="text-on-surface font-bold font-label-md">Products</h5>
                <ul class="space-y-4">
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="{{ path('homepage') }}">Gaming Series</a></li>
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="{{ path('workstations') }}">Workstations</a></li>
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="{{ path('business') }}">Business Ultra</a></li>
                </ul>
            </div>
            <div class="space-y-6">
                <h5 class="text-on-surface font-bold font-label-md">Resources</h5>
                <ul class="space-y-4">
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="#">Support</a></li>
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="#">Drivers &amp; Firmware</a></li>
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="#">Warranty</a></li>
                </ul>
            </div>
            <div class="space-y-6">
                <h5 class="text-on-surface font-bold font-label-md">Legal</h5>
                <ul class="space-y-4">
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="#">Terms of Service</a></li>
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="#">Privacy Policy</a></li>
                    <li><a class="text-on-surface-variant hover:text-primary transition-colors font-body-md"
                            href="#">Contact Us</a></li>
                </ul>
            </div>
        </div>
        <div
            class="px-margin-desktop py-8 border-t border-outline-variant/10 max-w-container-max mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
            <span class="text-on-surface-variant font-label-md opacity-60">© 2024 LUMINA ELITE. Precision Engineered
                Luxury.</span>
            <div class="flex gap-6">
                <span
                    class="material-symbols-outlined text-on-surface-variant cursor-pointer hover:text-primary transition-colors"
                    data-icon="share">share</span>
                <span
                    class="material-symbols-outlined text-on-surface-variant cursor-pointer hover:text-primary transition-colors"
                    data-icon="language">language</span>
            </div>
        </div>
    </footer>
    <script>
        document.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-like]');
            if (!btn) return;
            var productId = btn.dataset.product;
            var icon = btn.querySelector('[data-icon]');
            fetch('/products/' + productId + '/like', { method: 'POST' })
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    btn.dataset.liked = data.liked ? 'true' : 'false';
                    icon.textContent = data.liked ? 'favorite' : 'favorite_border';
                    icon.dataset.icon = data.liked ? 'favorite' : 'favorite_border';
                    icon.className = 'material-symbols-outlined text-[22px] transition-all ' + (data.liked ? 'text-error fill-current' : 'text-on-surface-variant');
                    var card = btn.closest('.bg-surface-container-lowest');
                    var countEl = card.querySelector('[data-likes-count="' + productId + '"]');
                    if (data.likesCount > 0) {
                        if (countEl) {
                            countEl.innerHTML = '<span class="material-symbols-outlined text-[16px]">favorite</span> ' + data.likesCount;
                        } else {
                            var priceRow = card.querySelector('.flex.items-center.justify-between.pt-2');
                            var priceGroup = priceRow.querySelector('.flex.items-center.gap-3');
                            var newCount = document.createElement('span');
                            newCount.className = 'text-on-surface-variant font-body-sm text-body-sm flex items-center gap-1';
                            newCount.setAttribute('data-likes-count', productId);
                            newCount.innerHTML = '<span class="material-symbols-outlined text-[16px]">favorite</span> ' + data.likesCount;
                            priceGroup.appendChild(newCount);
                        }
                    } else if (countEl) {
                        countEl.remove();
                    }
                });
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>

</html>
