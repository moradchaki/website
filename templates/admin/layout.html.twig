<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{% block title %}Admin | LUMINA ELITE{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;family=Inter:wght@100..900&amp;display=swap"
        rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .shadow-premium {
            box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.08);
        }
        .sidebar-link {
            transition: all 0.2s ease;
        }
        .sidebar-link:hover {
            background: rgba(0, 83, 219, 0.06);
        }
        .sidebar-link.active {
            background: rgba(0, 83, 219, 0.1);
            color: #0053db;
            font-weight: 600;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#0053db",
                        "on-primary": "#ffffff",
                        "primary-container": "#dbe1ff",
                        "on-primary-container": "#00174b",
                        "secondary": "#6001d1",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#eaddff",
                        "on-secondary-container": "#25005a",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error-container": "#410002",
                        "background": "#f7f9fb",
                        "on-background": "#191c1e",
                        "surface": "#f7f9fb",
                        "on-surface": "#191c1e",
                        "surface-variant": "#dfe2eb",
                        "on-surface-variant": "#43474e",
                        "outline": "#73777f",
                        "outline-variant": "#c3c6cf",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceeef",
                        "surface-container-high": "#e6e8e9",
                        "surface-container-highest": "#e0e2e4"
                    },
                    "borderRadius": {
                        "xl": "0.75rem",
                        "2xl": "1rem",
                        "3xl": "1.5rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-max": "1280px",
                        "gutter": "24px",
                        "margin-desktop": "64px",
                        "sidebar": "280px"
                    },
                    "fontFamily": {
                        "headline-lg": ["Geist"],
                        "headline-xl": ["Geist"],
                        "button-text": ["Geist"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "label-md": ["Geist"]
                    },
                    "fontSize": {
                        "headline-xl": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "button-text": ["16px", { "lineHeight": "1", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "label-md": ["14px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-surface-container-low text-on-surface font-body-md overflow-x-hidden">
    <div class="flex min-h-screen">
        <aside class="fixed top-0 left-0 z-40 h-screen w-[280px] bg-surface-container-lowest border-r border-outline-variant/30 flex flex-col">
            <div class="flex items-center h-20 px-6 border-b border-outline-variant/20">
                <a href="{{ path('admin_dashboard') }}" class="font-headline-lg text-headline-lg font-bold tracking-tighter text-primary">
                    LUMINA ELITE
                </a>
                <span class="ml-3 px-2 py-0.5 rounded-md bg-primary/10 text-primary text-[11px] font-bold uppercase tracking-wider">Admin</span>
            </div>

            <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
                <twig:SidebarLink href="{{ path('homepage') }}" icon="home" label="Home" />

                <twig:SidebarLink href="{{ path('admin_dashboard') }}" icon="dashboard" label="Dashboard" active="{{ app.current_route == 'admin_dashboard' }}" />

                <div class="pt-4 pb-1">
                    <span class="px-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant/50">Products</span>
                </div>

                <twig:SidebarLink href="{{ path('admin_product_index') }}" icon="inventory_2" label="All Products" active="{{ app.current_route starts with 'admin_product' }}" />

                <div class="pt-4 pb-1">
                    <span class="px-4 text-[11px] font-bold uppercase tracking-widest text-on-surface-variant/50">Sales</span>
                </div>

                <twig:SidebarLink href="{{ path('admin_order_index') }}" icon="receipt_long" label="Orders" active="{{ app.current_route starts with 'admin_order' }}" />

                <twig:SidebarLink href="{{ path('admin_transaction_index') }}" icon="receipt" label="Transactions" active="{{ app.current_route starts with 'admin_transaction' }}" />

                {% set order_stats_data = order_stats() %}
            </nav>
        </aside>

        <main class="ml-[280px] flex-1 min-h-screen">
            <header class="sticky top-0 z-30 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30 h-20 flex items-center justify-between px-8">
                <div>
                    <h1 class="font-headline-lg text-headline-lg text-on-surface">{% block page_title %}Dashboard{% endblock %}</h1>
                </div>
                <div class="flex items-center gap-4">
                    {% if app.user %}
                        <a href="{{ path('auth_profile') }}" class="material-symbols-outlined text-primary cursor-pointer hover:scale-110 transition-transform"
                            data-icon="account_circle">account_circle</a>
                        <span class="text-on-surface-variant font-body-md">{{ app.user.fullName }}</span>
                        <a href="{{ path('auth_logout') }}" class="material-symbols-outlined text-primary hover:scale-110 transition-transform" data-icon="logout">logout</a>
                    {% endif %}
                </div>
            </header>

            <div class="p-8">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-6 p-4 rounded-2xl {% if label == 'success' %}bg-green-50 text-green-800 border border-green-200{% elseif label == 'error' %}bg-error-container text-on-error-container{% else %}bg-primary-container text-on-primary-container{% endif %} font-body-md flex items-center gap-3">
                            <span class="material-symbols-outlined text-[20px]" data-icon="{% if label == 'success' %}check_circle{% elseif label == 'error' %}error{% else %}info{% endif %}">
                                {% if label == 'success' %}check_circle{% elseif label == 'error' %}error{% else %}info{% endif %}
                            </span>
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </main>
    </div>

    {% block javascripts %}{% endblock %}
</body>

</html>
