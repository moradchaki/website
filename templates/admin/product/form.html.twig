{% extends 'admin/layout.html.twig' %}

{% block title %}
	{{ product ? 'Edit' : 'New' }}
	Product | Admin | LUMINA ELITE
{% endblock %}

{% block page_title %}
	{{ product ? 'Edit Product' : 'New Product' }}
{% endblock %}

{% block body %}
	<div class="max-w-7xl">
		<form method="post" class="space-y-8">
			<div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/30 shadow-premium space-y-6">
				<h3 class="font-headline-lg text-[20px] text-on-surface pb-2 border-b border-outline-variant/20">Basic Information</h3>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<div class="space-y-2">
						<label class="font-label-md text-label-md text-on-surface font-medium">Product Name</label>
						<input type="text" name="name" value="{{ product.name|default('') }}" required class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
					</div>
					<div class="space-y-2">
						<label class="font-label-md text-label-md text-on-surface font-medium">SKU</label>
						<input type="text" name="sku" value="{{ product.sku|default('') }}" required class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
					</div>
				</div>

				<div class="space-y-2">
					<label class="font-label-md text-label-md text-on-surface font-medium">Short Description</label>
					<input type="text" name="shortDescription" value="{{ product.shortDescription|default('') }}" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
				</div>

				<div class="space-y-2">
					<label class="font-label-md text-label-md text-on-surface font-medium">Description</label>
					<textarea name="description" rows="5" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md">{{ product.description|default('') }}</textarea>
				</div>
			</div>

			<div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/30 shadow-premium space-y-6">
				<h3 class="font-headline-lg text-[20px] text-on-surface pb-2 border-b border-outline-variant/20">Pricing & Inventory</h3>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<div class="space-y-2">
						<label class="font-label-md text-label-md text-on-surface font-medium">Price ($)</label>
						<input type="number" name="price" value="{{ product.price|default('') }}" step="0.01" min="0" required class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
					</div>
					<div class="space-y-2">
						<label class="font-label-md text-label-md text-on-surface font-medium">Sale Price ($)</label>
						<input type="number" name="salePrice" value="{{ product.salePrice|default('') }}" step="0.01" min="0" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
					</div>
					<div class="space-y-2">
						<label class="font-label-md text-label-md text-on-surface font-medium">Stock</label>
						<input type="number" name="stock" value="{{ product.stock|default(0) }}" min="0" required class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
					</div>
				</div>
			</div>

			<div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/30 shadow-premium space-y-6">
				<h3 class="font-headline-lg text-[20px] text-on-surface pb-2 border-b border-outline-variant/20">Categories & Flags</h3>

				<div class="space-y-2">
					<label class="font-label-md text-label-md text-on-surface font-medium">Categories</label>
					<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
						{% for category in categories %}
							<label class="flex items-center gap-3 p-3 rounded-xl border border-outline-variant/20 cursor-pointer hover:bg-primary/5 transition-all has-[:checked]:bg-primary/10 has-[:checked]:border-primary/30">
								<input type="checkbox" name="categories[]" value="{{ category.id }}" {% if product and product.categories.contains(category) %} checked {% endif %} class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary/30"/>
								<span class="font-body-md text-body-md text-on-surface">{{ category.name }}</span>
							</label>
						{% endfor %}
					</div>
				</div>

				<div class="flex gap-6 pt-2">
					<label class="flex items-center gap-3 cursor-pointer">
						<input type="checkbox" name="isFeatured" value="1" {% if product and product.isFeatured %} checked {% endif %} class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary/30"/>
						<span class="font-body-md text-body-md text-on-surface">Featured Product</span>
					</label>
					<label class="flex items-center gap-3 cursor-pointer">
						<input type="checkbox" name="isNewArrival" value="1" {% if product and product.isNewArrival %} checked {% endif %} class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary/30"/>
						<span class="font-body-md text-body-md text-on-surface">New Arrival</span>
					</label>
				</div>
			</div>

			<div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/30 shadow-premium space-y-6">
				<h3 class="font-headline-lg text-[20px] text-on-surface pb-2 border-b border-outline-variant/20">Media</h3>

				<div class="space-y-2">
					<label class="font-label-md text-label-md text-on-surface font-medium">Image URL</label>
					<input type="url" name="imageUrl" value="{{ product.imageUrl|default('') }}" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md"/>
					<p class="text-on-surface-variant/50 text-[13px] mt-1">Enter a URL for the product image.</p>
				</div>
			</div>

			<div class="flex items-center justify-end gap-4">
				<a href="{{ path('admin_product_index') }}" class="w-10 h-10 flex items-center justify-center rounded-xl border border-outline-variant/30 text-on-surface hover:bg-surface-container-low transition-all" title="Cancel">
					<span class="material-symbols-outlined" data-icon="close">close</span>
				</a>
				<button type="submit" class="bg-primary text-on-primary px-8 py-3 rounded-xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg flex items-center gap-2">
					<span class="material-symbols-outlined" data-icon="save">save</span>
					{{ product ? 'Update' : 'Create' }}
				</button>
			</div>
		</form>
	</div>
{% endblock %}
