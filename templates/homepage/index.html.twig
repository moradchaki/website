{% extends 'base.html.twig' %}

{% block title %}LUMINA ELITE | Precision Engineered Luxury{% endblock %}

{% block body %}
<!-- Hero Section -->
<section class="relative min-h-[921px] flex items-center overflow-hidden hero-gradient">
    <div
        class="px-margin-desktop max-w-container-max mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center relative z-10">
        <div class="space-y-8">
            <div
                class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary font-label-md text-label-md">
                <span class="mr-2">NEW ARRIVAL</span>
                <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
            </div>
            <h1 class="font-display-lg text-display-lg leading-none text-on-surface">The Future of <br /><span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">High
                    Performance.</span></h1>
            <p class="text-on-surface-variant font-body-lg text-body-lg max-w-lg">Experience unprecedented power
                with the new Lumina Elite Series. Engineered for those who demand absolute technical superiority
                and seamless aesthetics.</p>
            <div class="flex flex-wrap gap-4 pt-4">
                <button
                    class="bg-primary text-on-primary px-8 py-4 rounded-xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg">Explore
                    Collection</button>
                <button
                    class="border-2 border-primary text-primary px-8 py-4 rounded-xl font-button-text text-button-text hover:bg-primary/5 transition-all">Compare
                    Models</button>
            </div>
        </div>
        <div class="relative flex justify-center items-center">
            <div class="absolute w-[120%] h-[120%] bg-primary/5 blur-[100px] rounded-full"></div>
            <img alt="A futuristic, hyper-realistic 3D render of a slim carbon-fiber laptop suspended in mid-air against a deep slate background. The device is illuminated by cinematic neon blue and soft violet lighting from multiple angles, highlighting its brushed metal texture and sharp edges. The screen glows with a vibrant, high-refresh rate abstract wallpaper, casting a soft indigo glow. The overall atmosphere is premium, sophisticated, and technologically advanced."
                class="relative z-10 w-full h-auto drop-shadow-2xl animate-float"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBJfwXiB2xRohxsBMLoSdLngbKQy6o4ohE6XCh-_SrwqRMCGsZR1UYWW6VG4zJKUCVG9qMc3uzlt8_k2HfxXpUOKFwYygobhEBh6QSvCezKZMFuHx0w12tGE731a1e4JSgep4RNbFZW0JCpV2VPm3yUIYyRqMIL4tVxp17OiTIxll1QZPqq5KuZqZoovVwW5HZVoqI_6PJb4-EIaP3gcyNrPmX6a99kXMUlHNOb3zNFHGAdhqcf0SgjWoYACZh-FKh55O0nOmW1agU" />
        </div>
    </div>
</section>
<!-- Brand Carousel -->
<section class="py-12 bg-surface-container-lowest border-y border-outline-variant/20">
    <div class="max-w-container-max mx-auto px-margin-desktop">
        <div
            class="flex flex-wrap justify-between items-center gap-12 opacity-40 grayscale hover:grayscale-0 transition-all duration-700 text-on-surface">
            <span class="font-headline-lg font-bold">RAZER</span>
            <span class="font-headline-lg font-bold">APPLE</span>
            <span class="font-headline-lg font-bold">ASUS</span>
            <span class="font-headline-lg font-bold">DELL</span>
            <span class="font-headline-lg font-bold">MSI</span>
        </div>
    </div>
</section>
<!-- Featured Categories (Bento Grid) -->
<section class="py-40 px-margin-desktop max-w-container-max mx-auto">
    <div class="mb-16">
        <h2 class="font-headline-xl text-headline-xl mb-4 text-on-surface">Master Your Domain</h2>
        <p class="text-on-surface-variant font-body-lg text-body-lg">Precision tools for every professional
            vertical.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter h-[600px]">
        <div
            class="md:col-span-2 group relative overflow-hidden rounded-3xl glass transition-all hover:translate-y-[-8px] hover:shadow-premium">
            <div
                class="absolute inset-0 bg-gradient-to-t from-surface-container-highest/60 to-transparent z-10">
            </div>
            <img alt="A dramatic wide shot of a high-end gaming setup in a dimly lit room with deep blue ambient lighting. A sophisticated matte black gaming laptop sits at the center, its RGB keyboard glowing with a custom electric blue pattern. Beside it are premium peripherals and an oversized ultra-wide monitor displaying an immersive high-fidelity game world. The scene is clean, minimalist, and exudes a sense of elite performance and high-stakes competition."
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCJVu9POKXDjLalcdMPzbl7dN2SsGWFmmPqUlhMk_FkCcTRVnr1NGobVlVPhi_YgNWts-H1-h2x_bAyc4Hmm86VEY_ADsh2h4dVP8SeRxkcdrLaaLIwmstpJNjWkAw6a7m_KnsXs3qpRnTvnMGvfRDj5lyjSR6hT37Vi9BLlcgGfMKePJAmodYAplMYPZcMorBGxf3_ext3jXgVSVrzsaj1SV0xJ_NlELqxHxKTV5wGnkiO-4kqrXvLzMS2BUAYTfA8zgP7s4LNadg" />
            <div class="relative z-20 p-12 h-full flex flex-col justify-end">
                <span class="text-primary font-label-md text-label-md tracking-widest uppercase mb-4">Power
                    Unbound</span>
                <h3 class="font-headline-lg text-headline-lg mb-4 text-white drop-shadow-md">Elite Gaming</h3>
                <p class="text-white max-w-md drop-shadow-md">Uncompromising frame rates and liquid-smooth
                    visuals for the serious competitor.</p>
            </div>
        </div>
        <div class="flex flex-col gap-gutter">
            <div
                class="h-1/2 group relative overflow-hidden rounded-3xl glass transition-all hover:translate-y-[-8px] hover:shadow-premium">
                <div
                    class="absolute inset-0 bg-gradient-to-t from-surface-container-highest/60 to-transparent z-10">
                </div>
                <img alt="A clean, minimalist office desk featuring a sleek, silver professional laptop on a high-quality leather desk pad. The environment is flooded with natural daylight from a large window, creating a bright and airy light-mode feel. Small aesthetic plants and a minimalist desk clock provide a calm, productive atmosphere. The focus is on clean lines, luxury materials, and a sense of effortless corporate sophistication."
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBpQkbCL4uVP4hTiNbuk1W-DtX3OQnAdEuLjWQGyzovWsFAWJdZzAZeVhF-KmTtc2NXZeki2d0gFa_VGIk0Gr6ZVaQjF059Kvvz2DbDMM7TuUyPpsxnB24FHykR9ckhidnHAjkQ1O4LkBF_h4FCDaIGb7ZqVRkl57VR1rVwHhVHEkrtQu8aea0-9Gi2DlQrCybE4vmtfC5uuye6rpNq9LvRqQd_mUep4IA6eMObqJVGYTjcWmrpRE1GM-PPbBl39fSOGW9KB5ZiEII" />
                <div class="relative z-20 p-8 h-full flex flex-col justify-end">
                    <h3 class="font-headline-lg text-headline-lg mb-2 text-white drop-shadow-md">Business</h3>
                </div>
            </div>
            <div
                class="h-1/2 group relative overflow-hidden rounded-3xl glass transition-all hover:translate-y-[-8px] hover:shadow-premium">
                <div
                    class="absolute inset-0 bg-gradient-to-t from-surface-container-highest/60 to-transparent z-10">
                </div>
                <img alt="A close-up view of a professional studio workstation where a powerful computer is being used for complex 3D rendering and video editing. The screen displays intricate structural blueprints with vibrant colored highlights. The room is dark, lit only by the soft glow of the monitor and warm industrial-style desk lamps, creating a focused, high-productivity mood. The aesthetic is technical, precise, and highly sophisticated."
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBf_naB2xx5c8SNmSSVxs_xh3ieJ25waBP-jN_yFavr-Sa7ymzSmn_TKj_x4c4HN5YnIC17G31qO4-Mc_qpeaSIoIkJgB-US3B9x-ZCpj6kBQTtMbypFO9qYaD0Gu2LiXVzyK7mwhvKhJ1gBkHzN6RTB4EoMpMzkDE7j8Addh_zDeTV_u_LXQ7oTUAFjh8sdax-T4cmim1_U333eF-jjjoFGUbIEzfec0uvTQmyr3OSnXEfC_XAaVtUCNj8DQ4A-wzRcKRT6WWKWYs" />
                <div class="relative z-20 p-8 h-full flex flex-col justify-end">
                    <h3 class="font-headline-lg text-headline-lg mb-2 text-white drop-shadow-md">Workstations
                    </h3>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-32 px-margin-desktop max-w-container-max mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {% for product in showcaseProducts %}
        {% set labels = ['Flagship Performance', 'Ultimate Power', 'Esports Ready'] %}
        <div class="bg-surface-container-lowest rounded-3xl border border-outline-variant/30 overflow-hidden hover:shadow-premium transition-all group">
            <div class="aspect-[4/3] overflow-hidden bg-surface-container-low">
                <img src="{{ product.imageUrl }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="p-6 space-y-4">
                <span class="text-primary font-label-md text-label-md tracking-widest uppercase">{{ labels[loop.index0] }}</span>
                <h3 class="font-headline-lg text-[22px] text-on-surface">{{ product.name }}</h3>
                <p class="text-on-surface-variant font-body-md text-body-md line-clamp-2">{{ product.description }}</p>
                <div class="flex items-center justify-between pt-2">
                    <span class="text-primary font-headline-lg text-[24px] font-bold">${{ product.price|number_format(0) }}</span>
                    {% if app.user %}
                        <form action="{{ path('cart_add', { id: product.id }) }}" method="POST">
                            <button class="bg-primary text-on-primary px-5 py-2.5 rounded-xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg text-sm cursor-pointer">Add to Cart</button>
                        </form>
                    {% else %}
                        <a href="{{ path('auth_login') }}" class="bg-primary/20 text-primary px-5 py-2.5 rounded-xl font-button-text text-button-text hover:bg-primary/30 transition-all text-sm">Sign In to Buy</a>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
<!-- Newsletter Section -->
<section class="py-40 px-margin-desktop">
    <div class="max-w-container-max mx-auto rounded-[40px] overflow-hidden relative shadow-premium">
        <div class="absolute inset-0 bg-gradient-to-br from-primary to-secondary"></div>
        <div class="absolute inset-0 shimmer opacity-10"></div>
        <div class="relative z-10 p-16 md:p-24 flex flex-col items-center text-center space-y-8">
            <h2 class="font-display-lg text-white max-w-2xl">Stay at the Edge of Innovation</h2>
            <p class="text-white/90 font-body-lg text-body-lg max-w-xl">Join the Elite inner circle for
                exclusive early access to hardware drops and technical insights.</p>
            <form class="flex flex-col md:flex-row gap-4 w-full max-w-xl pt-4">
                <input
                    class="flex-1 px-8 py-5 rounded-2xl bg-white/10 border border-white/20 text-white placeholder:text-white/60 focus:outline-none focus:ring-2 focus:ring-white/50 transition-all backdrop-blur-md"
                    placeholder="Your professional email" type="email" />
                <button
                    class="bg-white text-primary px-10 py-5 rounded-2xl font-button-text text-button-text hover:shadow-xl active:scale-95 transition-all">Subscribe
                    Now</button>
            </form>
        </div>
    </div>
</section>
{% endblock %}
