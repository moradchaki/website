{% extends 'auth_layout.html.twig' %}

{% block title %}My Profile | LUMINA ELITE{% endblock %}

{% block body %}
<section class="py-20 px-margin-desktop max-w-container-max mx-auto">
    <div class="flex items-center justify-between mb-12 pb-8 border-b border-outline-variant/20">
        <div class="flex items-center gap-6">
            <div class="w-16 h-16 rounded-full bg-primary-container flex items-center justify-center">
                <span class="material-symbols-outlined text-3xl text-primary" data-icon="person">person</span>
            </div>
            <div>
                <h1 class="font-headline-lg text-headline-lg text-on-surface">{{ user.fullName }}</h1>
                <p class="text-on-surface-variant font-body-md">{{ user.email }}</p>
                {% if user.isStudentVerified %}
                    <span class="mt-1 px-3 py-0.5 inline-block rounded-full bg-primary/10 text-primary font-label-md text-label-md text-sm">Student Verified</span>
                {% endif %}
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a href="{{ path('admin_dashboard') }}"
                class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary text-on-primary hover:brightness-110 active:scale-95 transition-all shadow-lg">
                <span class="material-symbols-outlined" data-icon="dashboard">dashboard</span>
            </a>
            <a href="{{ path('auth_logout') }}"
                class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary text-on-primary hover:brightness-110 active:scale-95 transition-all shadow-lg">
                <span class="material-symbols-outlined" data-icon="logout">logout</span>
            </a>
        </div>
    </div>

    <div>
        <div class="p-8 rounded-3xl bg-surface-container-lowest border border-outline-variant/30 shadow-premium">
            <h3 class="font-headline-lg text-headline-lg text-on-surface mb-8">Order History</h3>

                {% if orders is empty %}
                    <div class="text-center py-16">
                        <span class="material-symbols-outlined text-6xl text-on-surface-variant/30 block mb-4" data-icon="shopping_bag">shopping_bag</span>
                        <p class="text-on-surface-variant text-body-lg">No orders yet.</p>
                        <a href="{{ path('product_index') }}" class="inline-block mt-6 bg-primary text-on-primary p-4 rounded-xl font-button-text text-button-text hover:brightness-110 transition-all">
                            <span class="material-symbols-outlined" data-icon="shopping_bag">shopping_bag</span>
                        </a>
                    </div>
                {% else %}
                    <div class="space-y-4">
                        {% for order in orders %}
                            <div class="p-6 rounded-2xl bg-surface-container-low border border-outline-variant/20 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                                <div>
                                    <span class="font-label-md text-label-md text-primary font-bold">{{ order.orderNumber }}</span>
                                    <p class="text-on-surface-variant text-body-md mt-1">{{ order.createdAt|date('M d, Y') }} &middot; {{ order.itemCount }} item(s)</p>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="font-headline-lg text-[20px] text-on-surface">${{ order.totalAmount|number_format(2) }}</span>
                                    <span class="px-3 py-1 rounded-full text-[12px] font-bold uppercase
                                        {% if order.status.value == 'delivered' %}bg-green-100 text-green-800
                                        {% elseif order.status.value == 'shipped' %}bg-blue-100 text-blue-800
                                        {% elseif order.status.value == 'cancelled' %}bg-red-100 text-red-800
                                        {% else %}bg-amber-100 text-amber-800{% endif %}">
                                        {{ order.status.value }}
                                    </span>
                                    <a href="{{ path('order_show', { id: order.id }) }}"
                                        class="material-symbols-outlined text-primary hover:scale-110 transition-transform" data-icon="visibility">visibility</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
</section>
{% endblock %}
