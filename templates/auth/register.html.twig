{% extends 'auth_layout.html.twig' %}

{% block title %}Create Account | LUMINA ELITE{% endblock %}

{% block body %}
<section class="min-h-[calc(100vh-80px)] flex items-center justify-center py-20">
    <div class="w-full max-w-md px-margin-desktop">
        <div class="text-center mb-12">
            <h1 class="font-display-lg text-display-lg text-on-surface mb-4">Join the Elite</h1>
            <p class="text-on-surface-variant font-body-lg text-body-lg">Create your account for exclusive access and faster checkout.</p>
        </div>

        <form method="post" class="space-y-6">
            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label for="firstName" class="flex items-center gap-2 font-label-md text-label-md text-on-surface font-medium">
                        <span class="material-symbols-outlined text-[18px]" data-icon="badge">badge</span>
                    </label>
                    <input type="text" id="firstName" name="firstName" required placeholder="John"
                        class="w-full px-6 py-4 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md" />
                </div>
                <div class="space-y-2">
                    <label for="lastName" class="flex items-center gap-2 font-label-md text-label-md text-on-surface font-medium">
                        <span class="material-symbols-outlined text-[18px]" data-icon="badge">badge</span>
                    </label>
                    <input type="text" id="lastName" name="lastName" required placeholder="Doe"
                        class="w-full px-6 py-4 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md" />
                </div>
            </div>

            <div class="space-y-2">
                <label for="email" class="flex items-center gap-2 font-label-md text-label-md text-on-surface font-medium">
                    <span class="material-symbols-outlined text-[18px]" data-icon="mail">mail</span>
                </label>
                <input type="email" id="email" name="email" required placeholder="your@email.com"
                    class="w-full px-6 py-4 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md" />
            </div>

            <div class="space-y-2">
                <label for="password" class="flex items-center gap-2 font-label-md text-label-md text-on-surface font-medium">
                    <span class="material-symbols-outlined text-[18px]" data-icon="lock">lock</span>
                </label>
                <input type="password" id="password" name="password" required minlength="8" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;"
                    class="w-full px-6 py-4 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-on-surface placeholder:text-on-surface-variant/50 focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all font-body-md" />
            </div>

            <button type="submit"
                class="w-full bg-primary text-on-primary py-4 rounded-2xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg flex items-center justify-center gap-2">
                <span class="material-symbols-outlined" data-icon="person_add">person_add</span>
            </button>
        </form>

        <p class="mt-8 text-center text-on-surface-variant font-body-md">
            <a href="{{ path('auth_login') }}" class="text-primary font-medium hover:underline flex items-center justify-center gap-1">
                <span class="material-symbols-outlined text-[18px]" data-icon="login">login</span>
            </a>
        </p>
    </div>
</section>
{% endblock %}
