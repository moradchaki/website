<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>{% block title %}LUMINA ELITE | Precision Engineered Luxury{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&amp;family=Inter:wght@100..900&amp;display=swap"
        rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .shadow-premium {
            box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.08);
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "primary": "#0053db",
                        "on-primary": "#ffffff",
                        "primary-container": "#dbe1ff",
                        "on-primary-container": "#00174b",
                        "secondary": "#6001d1",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#eaddff",
                        "on-secondary-container": "#25005a",
                        "tertiary": "#8d4f00",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#ffdbcd",
                        "on-tertiary-container": "#360f00",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error-container": "#410002",
                        "background": "#f7f9fb",
                        "on-background": "#191c1e",
                        "surface": "#f7f9fb",
                        "on-surface": "#191c1e",
                        "surface-variant": "#dfe2eb",
                        "on-surface-variant": "#43474e",
                        "outline": "#73777f",
                        "outline-variant": "#c3c6cf",
                        "inverse-surface": "#2e3133",
                        "inverse-on-surface": "#eff1f3",
                        "inverse-primary": "#b4c5ff",
                        "surface-dim": "#d8dadc",
                        "surface-bright": "#f7f9fb",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceeef",
                        "surface-container-high": "#e6e8e9",
                        "surface-container-highest": "#e0e2e4"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.5rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    "spacing": {
                        "container-max": "1280px",
                        "gutter": "24px",
                        "margin-mobile": "20px",
                        "margin-desktop": "64px",
                        "unit": "8px"
                    },
                    "fontFamily": {
                        "headline-xl": ["Geist"],
                        "display-lg": ["Geist"],
                        "headline-lg": ["Geist"],
                        "button-text": ["Geist"],
                        "body-lg": ["Inter"],
                        "body-md": ["Inter"],
                        "display-lg-mobile": ["Geist"],
                        "label-md": ["Geist"]
                    },
                    "fontSize": {
                        "headline-xl": ["48px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "600" }],
                        "display-lg": ["64px", { "lineHeight": "1.1", "letterSpacing": "-0.04em", "fontWeight": "700" }],
                        "headline-lg": ["32px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "button-text": ["16px", { "lineHeight": "1", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "display-lg-mobile": ["40px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-md": ["14px", { "lineHeight": "1", "letterSpacing": "0.05em", "fontWeight": "500" }]
                    }
                },
            },
        }
    </script>
    {% block stylesheets %}{% endblock %}
</head>

<body class="bg-background text-on-surface font-body-md overflow-x-hidden">
    <nav class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/30 shadow-premium">
        <div class="flex items-center h-20 px-margin-desktop max-w-container-max mx-auto">
            <a class="font-headline-lg text-headline-lg font-bold tracking-tighter text-primary" href="{{ path('homepage') }}">
                LUMINA ELITE
            </a>
        </div>
    </nav>
    <main class="pt-20">
        {% block body %}{% endblock %}
    </main>
    {% block javascripts %}{% endblock %}
</body>

</html>
