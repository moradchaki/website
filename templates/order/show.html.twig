{% extends 'base.html.twig' %}

{% block title %}Order {{ order.orderNumber }} | LUMINA ELITE{% endblock %}

{% block body %}
<section class="py-16 px-margin-desktop max-w-container-max mx-auto">
    <div class="mb-12">
        <a href="{{ path('order_index') }}" class="text-primary font-button-text text-button-text hover:underline flex items-center gap-2 mb-6">
            <span class="material-symbols-outlined" data-icon="arrow_back" style="font-size:20px">arrow_back</span>
            Back to Orders
        </a>
        <h1 class="font-headline-xl text-headline-xl text-on-surface mb-2">Order {{ order.orderNumber }}</h1>
        <p class="text-on-surface-variant font-body-lg text-body-lg">{{ order.createdAt|date('F d, Y - H:i') }}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-4">
            {% for item in order.items %}
                <div class="bg-surface-container-lowest rounded-3xl border border-outline-variant/30 p-6 flex items-center gap-6">
                    <div class="w-20 h-20 bg-surface-container-low rounded-xl p-3 flex items-center justify-center shrink-0">
                        <img src="{{ item.product.imageUrl }}" alt="{{ item.product.name }}" class="w-full h-full object-contain">
                    </div>
                    <div class="flex-1">
                        <h3 class="font-headline-lg text-[18px] text-on-surface">{{ item.product.name }}</h3>
                        <p class="text-on-surface-variant text-[13px]">Qty: {{ item.quantity }} &middot; ${{ item.unitPrice|number_format(2) }} each</p>
                    </div>
                    <span class="text-primary font-headline-lg text-[20px]">${{ item.totalPrice|number_format(2) }}</span>
                </div>
            {% endfor %}
        </div>

        <div class="bg-surface-container-lowest rounded-3xl border border-outline-variant/30 p-6 h-fit sticky top-28 space-y-4">
            <h3 class="font-headline-lg text-[20px] text-on-surface">Order Summary</h3>
            <div class="space-y-2 text-on-surface-variant font-body-md">
                <div class="flex justify-between"><span>Subtotal</span><span class="text-on-surface">${{ order.subtotal|number_format(2) }}</span></div>
                <div class="flex justify-between"><span>Shipping</span><span class="text-on-surface">${{ order.shippingAmount|number_format(2) }}</span></div>
                <div class="flex justify-between"><span>Tax</span><span class="text-on-surface">${{ order.taxAmount|number_format(2) }}</span></div>
            </div>
            <div class="border-t border-outline-variant/20 pt-4">
                <div class="flex justify-between font-headline-lg text-[20px] text-on-surface">
                    <span>Total</span>
                    <span class="text-primary">${{ order.totalAmount|number_format(2) }}</span>
                </div>
            </div>
            <div class="pt-2">
                <span class="px-3 py-1 rounded-full text-[12px] font-medium {% if order.status.value == 'pending' %}bg-amber-100 text-amber-800{% elseif order.status.value == 'completed' %}bg-green-100 text-green-800{% else %}bg-surface-container-high text-on-surface-variant{% endif %}">{{ order.status.value|capitalize }}</span>
            </div>
        </div>
    </div>
</section>
{% endblock %}
