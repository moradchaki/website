<a href="{{ href }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all {% if active %}bg-primary-container text-on-primary-container{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
    <span class="material-symbols-outlined text-[20px]" data-icon="{{ icon }}">{{ icon }}</span>
    <span class="font-button-text text-button-text">{{ label }}</span>
</a>
