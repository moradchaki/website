{% if href %}
    <a href="{{ href }}" class="inline-flex items-center justify-center gap-2 font-button-text text-button-text rounded-xl transition-all active:scale-95 {% if variant == 'primary' %}bg-primary text-on-primary hover:brightness-110 shadow-lg{% elseif variant == 'secondary' %}border-2 border-primary text-primary hover:bg-primary/5{% elseif variant == 'ghost' %}text-primary hover:bg-primary/10{% elseif variant == 'danger' %}bg-error text-on-error hover:brightness-110 shadow-lg{% endif %} {% if size == 'sm' %}px-4 py-2 text-sm{% elseif size == 'lg' %}px-10 py-5{% else %}px-6 py-3{% endif %}">
        {% if icon %}<span class="material-symbols-outlined text-[{{ size == 'sm' ? '18' : '20' }}px]" data-icon="{{ icon }}">{{ icon }}</span>{% endif %}
        {{ label }}
    </a>
{% else %}
    <button type="{{ type }}" class="inline-flex items-center justify-center gap-2 font-button-text text-button-text rounded-xl transition-all active:scale-95 cursor-pointer {% if variant == 'primary' %}bg-primary text-on-primary hover:brightness-110 shadow-lg{% elseif variant == 'secondary' %}border-2 border-primary text-primary hover:bg-primary/5{% elseif variant == 'ghost' %}text-primary hover:bg-primary/10{% elseif variant == 'danger' %}bg-error text-on-error hover:brightness-110 shadow-lg{% endif %} {% if size == 'sm' %}px-4 py-2 text-sm{% elseif size == 'lg' %}px-10 py-5{% else %}px-6 py-3{% endif %}">
        {% if icon %}<span class="material-symbols-outlined text-[{{ size == 'sm' ? '18' : '20' }}px]" data-icon="{{ icon }}">{{ icon }}</span>{% endif %}
        {{ label }}
    </button>
{% endif %}
