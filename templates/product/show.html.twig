{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | LUMINA ELITE{% endblock %}

{% block body %}
<section class="py-32 px-margin-desktop max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row gap-16">
        <div class="flex-1">
            <div class="rounded-3xl overflow-hidden bg-surface-container-low">
                <img src="{{ product.imageUrl }}" alt="{{ product.name }}" class="w-full h-auto" />
            </div>
        </div>
        <div class="flex-1 space-y-6">
            <h1 class="font-headline-xl text-headline-xl text-on-surface">{{ product.name }}</h1>
            <p class="text-on-surface-variant font-body-lg text-body-lg">{{ product.description }}</p>
            <div class="text-primary font-headline-lg text-[36px] font-bold">${{ product.price|number_format(2) }}</div>
            <div class="flex items-center gap-6">
                <span class="text-on-surface-variant font-body-md">Stock: <strong class="text-on-surface">{{ product.stock }}</strong></span>
            </div>
            <div class="flex items-center gap-6 pt-2">
                <span class="flex items-center gap-2 text-on-surface-variant font-body-md">
                    <span class="material-symbols-outlined text-[20px]">favorite</span>
                    <strong class="text-on-surface">{{ product.likesCount }}</strong>
                </span>
                <span class="flex items-center gap-2 text-on-surface-variant font-body-md">
                    <span class="material-symbols-outlined text-[20px]">visibility</span>
                    <strong class="text-on-surface">{{ product.viewsCount }}</strong>
                </span>
                <span class="flex items-center gap-2 text-on-surface-variant font-body-md">
                    <span class="material-symbols-outlined text-[20px]">shopping_cart</span>
                    <strong class="text-on-surface">{{ product.orderItems|length }}</strong>
                </span>
            </div>
            {% if app.user %}
                <form action="{{ path('cart_add', { id: product.id }) }}" method="POST">
                    <button class="bg-primary text-on-primary px-8 py-4 rounded-xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg cursor-pointer flex items-center gap-2">
                        <span class="material-symbols-outlined" data-icon="add_shopping_cart">add_shopping_cart</span>
                        Cart
                    </button>
                </form>
            {% else %}
                <a href="{{ path('auth_login') }}" class="inline-block bg-primary/20 text-primary px-8 py-4 rounded-xl font-button-text text-button-text hover:bg-primary/30 transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined" data-icon="login">login</span>
                    Sign In
                </a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}