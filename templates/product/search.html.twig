{% extends 'base.html.twig' %}

{% block title %}Search: {{ query }} | LUMINA ELITE{% endblock %}

{% block body %}
<section class="py-32 px-margin-desktop max-w-container-max mx-auto">
    <div class="mb-12">
        <h1 class="font-headline-xl text-headline-xl text-on-surface">Search Results</h1>
        <p class="text-on-surface-variant font-body-lg text-body-lg mt-2">{{ products|length }} results for "{{ query }}"</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {% for product in products %}
            <twig:ProductCard :product="product" />
        {% else %}
            <div class="col-span-full text-center py-20">
                <span class="material-symbols-outlined text-5xl text-outline-variant block mb-4" data-icon="search_off">search_off</span>
                <p class="text-on-surface-variant font-headline-lg text-headline-lg">No results for "{{ query }}"</p>
                <p class="text-on-surface-variant font-body-md mt-2">Try different keywords or browse our categories.</p>
            </div>
        {% endfor %}
    </div>
</section>
{% endblock %}