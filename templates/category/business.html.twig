                <p class="text-on-surface-variant text-body-md">Intel Core Ultra 7 · 16GB · 512GB SSD</p>
                <span class="text-primary font-headline-lg text-[24px]">$1,899</span>
            </div>
        </div>
        <div class="group bg-surface-container-lowest rounded-3xl border border-outline-variant/30 overflow-hidden transition-all hover:translate-y-[-8px] hover:shadow-premium">
            <div class="aspect-square p-8 flex items-center justify-center bg-surface-container-low">
                <img alt="Premium silver laptop" class="w-full h-auto group-hover:scale-105 transition-transform duration-500"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0AA4TXl4AR8b_eX40565XoTm4jbrOPeWK-tSbUxyG5d5SiaJh2h6z2AuCRNaV1U1_5HR-trAXRuaFLqs6W8vzbTp9Zncwxw-OIenukrvc4oVSX7SNv87od26pVaLm-i63HLhpXWIbs8V8rst43W7RJrD6uTN9JUDNUJ5VAFlJnogT5uHOLorpOXrIReEUqrm28zxe0S5YQTeJuOtOZdgkecK4gV4cD98MoaHUbQ3Z_LQCDwWyIklguScA6RSj850WfplW5XFxRPI" />
            </div>
            <div class="p-6 space-y-4">
                <h4 class="font-headline-lg text-[20px] text-on-surface">Latitude 9550</h4>
                <p class="text-on-surface-variant text-body-md">Intel Core Ultra 7 · 16GB · 256GB SSD</p>
                <span class="text-primary font-headline-lg text-[24px]">$1,699</span>
            </div>
        </div>
    </div>
</section>

<section class="py-32 bg-surface-container-low">
    <div class="px-margin-desktop max-w-container-max mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter">
            <div class="text-center p-8">
                <span class="material-symbols-outlined text-primary text-5xl block mb-4" data-icon="security">security</span>
                <h4 class="font-headline-lg text-headline-lg text-on-surface mb-2">Enterprise Security</h4>
                <p class="text-on-surface-variant text-body-md">TPM 2.0, biometric authentication, and zero-trust architecture out of the box.</p>
            </div>
            <div class="text-center p-8">
                <span class="material-symbols-outlined text-primary text-5xl block mb-4" data-icon="battery_full">battery_full</span>
                <h4 class="font-headline-lg text-headline-lg text-on-surface mb-2">All-Day Battery</h4>
                <p class="text-on-surface-variant text-body-md">Up to 18 hours of runtime on a single charge for uninterrupted workflows.</p>
            </div>
            <div class="text-center p-8">
                <span class="material-symbols-outlined text-primary text-5xl block mb-4" data-icon="precision_manufacturing">precision_manufacturing</span>
                <h4 class="font-headline-lg text-headline-lg text-on-surface mb-2">MIL-STD-810H</h4>
                <p class="text-on-surface-variant text-body-md">Tested against drops, vibration, humidity, and extreme temperatures.</p>
            </div>
            <div class="text-center p-8">
                <span class="material-symbols-outlined text-primary text-5xl block mb-4" data-icon="support_agent">support_agent</span>
                <h4 class="font-headline-lg text-headline-lg text-on-surface mb-2">Dedicated Support</h4>
                <p class="text-on-surface-variant text-body-md">24/7 priority support with dedicated account management for business clients.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
