{% extends 'base.html.twig' %}

{% block title %}Business Laptops | LUMINA ELITE{% endblock %}

{% block body %}
<section class="relative min-h-[600px] flex items-center overflow-hidden bg-surface-container-low">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-secondary/5"></div>
    <div class="px-margin-desktop max-w-container-max mx-auto w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center relative z-10">
        <div class="space-y-8">
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary font-label-md text-label-md">
                <span>PROFESSIONAL GRADE</span>
            </div>
            <h1 class="font-display-lg text-display-lg leading-none text-on-surface">Power Your <br /><span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">Enterprise.</span></h1>
            <p class="text-on-surface-variant font-body-lg text-body-lg max-w-lg">Engineered for the modern professional. Military-grade durability meets enterprise security in ultra-portable chassis designed for non-stop productivity.</p>
            <div class="flex flex-wrap gap-4 pt-4">
                <button class="bg-primary text-on-primary px-8 py-4 rounded-xl font-button-text text-button-text hover:brightness-110 active:scale-95 transition-all shadow-lg">View Business Series</button>
                <button class="border-2 border-primary text-primary px-8 py-4 rounded-xl font-button-text text-button-text hover:bg-primary/5 transition-all">Talk to an Expert</button>
            </div>
        </div>
        <div class="relative flex justify-center items-center">
            <div class="absolute w-[120%] h-[120%] bg-primary/5 blur-[100px] rounded-full"></div>
            <img alt="A clean, minimalist office desk featuring a sleek, silver professional laptop on a high-quality leather desk pad. The environment is flooded with natural daylight from a large window, creating a bright and airy light-mode feel."
                class="relative z-10 w-full h-auto drop-shadow-2xl"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuBpQkbCL4uVP4hTiNbuk1W-DtX3OQnAdEuLjWQGyzovWsFAWJdZzAZeVhF-KmTtc2NXZeki2d0gFa_VGIk0Gr6ZVaQjF059Kvvz2DbDMM7TuUyPpsxnB24FHykR9ckhidnHAjkQ1O4LkBF_h4FCDaIGb7ZqVRkl57VR1rVwHhVHEkrtQu8aea0-9Gi2DlQrCybE4vmtfC5uuye6rpNq9LvRqQd_mUep4IA6eMObqJVGYTjcWmrpRE1GM-PPbBl39fSOGW9KB5ZiEII" />
        </div>
    </div>
</section>

